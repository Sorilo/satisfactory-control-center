# Immutable production image. Override with a full Git SHA for maximum pinning.
CONTROL_CENTER_IMAGE=ghcr.io/sorilo/satisfactory-control-center:v0.2.0-rc.3
CONTROL_CENTER_BIND=127.0.0.1
CONTROL_CENTER_PORT=3000
GAME_NETWORK=sorilonet

# Safe runtime default. No upstream is contacted.
DATA_MODE=mock
DEFAULT_SERVER_ID=main
DEFAULT_SERVER_NAME=Main World

# Set true only behind a trusted proxy that overwrites X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=false

# Opt in only after validating SSE through the deployed reverse proxy/Tunnel.
POWER_STREAM_ENABLED=false

# Live single-server mode (set DATA_MODE=live deliberately):
# FRM_BASE_URL=http://satisfactory-server:8080
# FRM_TOKEN=

# Multi-server mode replaces the single-server fields. Keep URLs/tokens private.
# SERVERS_JSON=[{"id":"main","displayName":"Main World","frmBaseUrl":"http://satisfactory-server:8080","enabled":true,"public":true}]

# Optional Slice 2 history mapping. This is separate from SERVERS_JSON so it can
# be removed for rollback without changing FRM/server identity configuration.
# PROMETHEUS_SERVERS_JSON=[{"serverId":"main","baseUrl":"http://prometheus:9090","urlLabel":"satisfactory-server:7777","sessionLabel":"Main World"}]
